# Env — never commit real values. Copy to .env.local
# Moss (from https://portal.usemoss.dev) — REQUIRED for real retrieval
MOSS_PROJECT_ID=your_project_id
MOSS_PROJECT_KEY=your_project_key
MOSS_INDEX_NAME=mission-room-knowledge

# Postgres — OPTIONAL (production / Docker). Leave commented for zero-setup PGlite dev.
# A) PGlite (default): keep DATABASE_URL commented/empty — no Docker, no Postgres needed. See lib/db/client.ts:13-21
# B) Docker/Postgres: uncomment and use postgres://mission:mission@localhost:5432/mission_room
#    If host Postgres already on 5432 (native postgres.exe), use 5433: DATABASE_URL=postgres://mission:mission@localhost:5433/mission_room and change docker-compose.yml ports to "5433:5432"
# Example: postgres://mission:mission@localhost:5432/mission_room
# DATABASE_URL=postgres://mission:mission@localhost:5432/mission_room
# Local dev fallback uses PGlite (embedded, no daemon). No config needed when DATABASE_URL is unset.
# LLM — reuse opencode auth by default. Only set if using direct provider:
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
